{
  "name": "twitch-ai-rpg",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch apps/server/src/main.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "start": "node --env-file-if-exists=.env --import tsx apps/server/src/main.ts",
    "build": "vite build --config apps/web/vite.config.ts",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "db:migrate": "tsx apps/server/src/migrate.ts",
    "local": "node scripts/local.mjs",
    "test:integration": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run apps/server/test"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/static": "8.3.0",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "tsx": "4.23.15",
    "vue": "3.5.44",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "jsdom": "30.1.3",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  }
}
